# mock = dữ liệu mô phỏng, không gọi MoMo (mặc định). live = gọi API thật.
MOMO_MODE=mock

# Số proxy tin cậy đứng trước app (mặc định 1). Giới hạn tần suất lấy IP khách từ x-forwarded-for
# theo số này; đặt đúng với hạ tầng triển khai, nếu không IP có thể bị giả mạo hoặc gom chung.
TRUSTED_PROXY_HOPS=1

# --- Chỉ cần khi MOMO_MODE=live ---
# Base URL do MoMo cấp (tài liệu chỉ nêu ví dụ, chưa nói rõ sandbox hay production).
MOMO_BASE_URL=
MOMO_API_KEY=
# Tài liệu chỉ nói "API key trong header", không nêu tên header: xác nhận với MoMo rồi sửa nếu khác.
MOMO_API_KEY_HEADER=x-api-key

# --- Webhook nhận thông báo định kỳ (bắt buộc khi live) ---
# Cấp riêng cho đối tác. Ở mock, nếu bỏ trống sẽ dùng bộ khóa demo công khai.
MOMO_WEBHOOK_CLIENT_ID=
MOMO_WEBHOOK_API_KEY=
MOMO_WEBHOOK_SECRET=
