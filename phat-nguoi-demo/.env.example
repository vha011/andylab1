# mock = dữ liệu mô phỏng, không gọi API (mặc định). live = gọi API thật.
PHATNGUOI_MODE=mock

# Số proxy tin cậy đứng trước app (mặc định 1). Giới hạn tần suất lấy IP khách từ x-forwarded-for
# theo số này; đặt đúng với hạ tầng triển khai, nếu không IP có thể bị giả mạo hoặc gom chung.
TRUSTED_PROXY_HOPS=1

# --- Chỉ cần khi PHATNGUOI_MODE=live ---
# Base URL do bên cung cấp API cấp (tài liệu chỉ nêu ví dụ, chưa nói rõ sandbox hay production).
PHATNGUOI_BASE_URL=
PHATNGUOI_API_KEY=
# Tài liệu chỉ nói "API key trong header", không nêu tên header: xác nhận với bên cung cấp API rồi sửa nếu khác.
PHATNGUOI_API_KEY_HEADER=x-api-key

# --- Webhook nhận thông báo định kỳ (bắt buộc khi live) ---
# Cấp riêng cho đối tác. Ở mock, nếu bỏ trống sẽ dùng bộ khóa demo công khai.
PHATNGUOI_WEBHOOK_CLIENT_ID=
PHATNGUOI_WEBHOOK_API_KEY=
PHATNGUOI_WEBHOOK_SECRET=
